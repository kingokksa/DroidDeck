+    static void ddrel_log( const char *fmt, ... )
+    {
+        FILE *pDDREL = fopen( "/tmp/ddrel.log", "a" );
+        if ( !pDDREL )
+            return;
+        va_list args;
+        va_start( args, fmt );
+        vfprintf( pDDREL, fmt, args );
+        va_end( args );
+        fclose( pDDREL );
